# adjust starship prompt
alias preset-catppuccin-powerline='starship preset catppuccin-powerline -o ~/.config/starship.toml --force'
alias preset-nerd-font-symbols='starship preset nerd-font-symbols -o ~/.config/starship.toml --force'
alias preset-no-nerd-font='starship preset no-nerd-font -o ~/.config/starship.toml --force'
alias preset-plain-text-symbols='starship preset plain-text-symbols -o ~/.config/starship.toml --force'

# change mode of bash
## https://dev.to/brandonwallace/how-to-use-vim-mode-on-the-command-line-in-bash-fnn
alias vmode='set -o vi'
alias emode='set -o emacs'

# interactive mode warns before overwriting or deleting files
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# change directories
alias ..='cd ..'
alias ...='cd ../..'
alias dl='cd ~/Downloads'
alias rp='cd ~/repos'
alias ws='cd ~/workspace'

# exit
alias e='exit'

# grep
alias grep='grep --color=auto'

# ls
alias ls='ls --color=auto' # overrides alias in ~/.bashrc
alias ll='ls -lF'
alias la='ls -A'
alias l='ls -CF'

# git
alias 'g?'='alias | grep git | grep -i'
alias 'git?'='alias | grep git -n'
alias gitk='gitk &'
alias ga='git add'
alias gac='git add . && git commit -m'
alias gap='git add -p'
alias gcm='git commit -m'
alias gcam='git commit --amend -m'
alias gd='git diff'
alias gdc='git diff --cached'	# to see changes that have been staged (checked into the index) but not yet committed
alias glo='git log --oneline'
alias glp='git log -p'
alias gpull='git pull'
alias gpush='git push'
alias gs='git status'	# may conflict with gs for Ghostscript
alias gsoft='git reset --soft HEAD~1'	# To undo the latest commit while keeping all your files and changes exactly as they are

# ssh
## https://youtu.be/-Q4T9wLsvOQ?list=PLT98CRl2KxKEUHie1m24-wkyHpEsa4Y70&t=1393
alias ssha='eval $(ssh-agent) && ssh-add'

# systemctl
## https://cavecreekcoffee.com/linux-guides/systemctl-restart-vs-reload-understanding-the-critical-difference/
alias failed='systemctl --failed'
alias reboot-uefi='sudo systemctl reboot --firmware-setup'
alias start='sudo systemctl reload-or-restart'
alias status='systemctl status'
alias stop='sudo systemctl stop'

# terminal
alias c='clear'

# update system
alias uu='sudo apt update && sudo apt upgrade -y; sudo dnf update -y; flatpak update -y'
